{"title": "newsletter - Paintingdemons", "html": "<!-- MAIN CONTENT -->\n  <div class=\"pd-main\">\n    <style>\n    /* ========== NEWSLETTER SIGNUP FORM ========== */\n    .newsletter-container {\n      background: rgba(0, 0, 0, 0.7);\n      border: 2px solid #8b0000;\n      padding: 40px;\n      border-radius: 4px;\n      max-width: 500px;\n      width: 100%;\n      text-align: center;\n    }\n\n    .newsletter-title {\n      font-family: 'Sitka', 'Sitka Text', 'Georgia', 'Times New Roman', serif;\n      font-size: 24px;\n      font-weight: bold;\n      color: #e0d8d0;\n      text-transform: uppercase;\n      letter-spacing: 2px;\n      margin-bottom: 12px;\n      text-shadow: 0 0 10px rgba(139, 0, 0, 0.3);\n    }\n\n    .newsletter-subtitle {\n      font-family: 'Courier New', Courier, monospace;\n      font-size: 12px;\n      color: #ccc;\n      margin-bottom: 24px;\n      line-height: 1.6;\n    }\n\n    .newsletter-form {\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n\n    .newsletter-input {\n      background: #1a1a1a;\n      border: 2px solid #8b0000;\n      color: #fff;\n      padding: 12px 16px;\n      font-family: 'Courier New', Courier, monospace;\n      font-size: 13px;\n      border-radius: 3px;\n      transition: border-color 0.2s, box-shadow 0.2s;\n    }\n\n    .newsletter-input:focus {\n      outline: none;\n      border-color: #d32f2f;\n      box-shadow: 0 0 12px rgba(139, 0, 0, 0.5);\n    }\n\n    .newsletter-input::placeholder {\n      color: #666;\n    }\n\n    .newsletter-btn {\n      background: linear-gradient(180deg, #1a0a0a 0%, #000000 50%, #0a0000 100%);\n      border: 2px solid #8b0000;\n      color: #e0d8d0;\n      padding: 12px;\n      font-family: 'Courier New', Courier, monospace;\n      font-size: 12px;\n      font-weight: bold;\n      cursor: pointer;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n      transition: all 0.2s;\n      border-radius: 3px;\n    }\n\n    .newsletter-btn:hover {\n      background: linear-gradient(180deg, #2a0a0a 0%, #0d0000 50%, #1a0505 100%);\n      box-shadow: 0 0 12px rgba(139, 0, 0, 0.6);\n      border-color: #d32f2f;\n      color: #fff;\n    }\n\n    .newsletter-back-btn {\n      display: block;\n      background: linear-gradient(180deg, #1a0a0a 0%, #000000 50%, #0a0000 100%);\n      border: 2px solid #8b0000;\n      color: #999;\n      padding: 12px;\n      font-family: 'Courier New', Courier, monospace;\n      font-size: 12px;\n      font-weight: bold;\n      cursor: pointer;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n      transition: all 0.2s;\n      border-radius: 3px;\n      text-align: center;\n      text-decoration: none;\n      margin-top: 12px;\n    }\n\n    .newsletter-back-btn:hover {\n      background: linear-gradient(180deg, #2a0a0a 0%, #0d0000 50%, #1a0505 100%);\n      border-color: #d32f2f;\n      color: #ccc;\n    }\n\n    .newsletter-message {\n      font-family: 'Courier New', Courier, monospace;\n      font-size: 11px;\n      color: #999;\n      margin-top: 12px;\n      min-height: 14px;\n    }\n</style>\n\n<div style=\"display: flex; align-items: center; justify-content: center; min-height: 600px; padding: 40px 20px;\">\n  <div>\n    <div class=\"newsletter-container\">\n      <div class=\"newsletter-title\">Get Email Updates</div>\n      <div class=\"newsletter-subtitle\">\n        Subscribe to receive exclusive updates, new releases, and behind-the-scenes content from Paintingdemons.\n      </div>\n      <form class=\"newsletter-form\" id=\"newsletterForm\">\n        <input\n          type=\"email\"\n          class=\"newsletter-input\"\n          placeholder=\"Enter your email address\"\n          name=\"email\"\n          required\n          aria-label=\"Email address\"\n        >\n        <button type=\"submit\" class=\"newsletter-btn\">Subscribe</button>\n        <div class=\"newsletter-message\" id=\"newsletterMessage\"></div>\n      </form>\n    </div>\n    <a href=\"/\" class=\"newsletter-back-btn\">Go Back</a>\n  </div>\n</div>\n\n\n\n  </div>\n\n  <!-- FOOTER -->", "scripts": ["{\n\n  // Newsletter form handler\n  const form = document.getElementById('newsletterForm');\n  const messageDiv = document.getElementById('newsletterMessage');\n\n  form.addEventListener('submit', function(e) {\n    e.preventDefault();\n\n    const email = form.querySelector('input[name=\"email\"]').value;\n\n    // TODO: Replace this URL with your Shopify customer mailing list endpoint\n    const shopifyEndpoint = '/api/customers/email-list';\n\n    messageDiv.textContent = 'Subscribing...';\n    messageDiv.style.color = '#999';\n\n    // This will need to be connected to Shopify when the site goes live\n    setTimeout(() => {\n      messageDiv.textContent = 'Thank you for subscribing! Check your email for confirmation.';\n      messageDiv.style.color = '#7fb069';\n      form.querySelector('input[name=\"email\"]').value = '';\n    }, 800);\n  });\n\n}"]}